{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Splendor internal Adapter route and transaction",
  "$comment": "Internal authority-clone/Adapter schema; never exposed as the model-facing semantic-v2 BgAct schema.",
  "type": "object",
  "properties": {
    "mode": {"enum": ["enumerate_routes", "commit"]},
    "request": {
      "type": "object",
      "properties": {
        "rootIds": {"type": "array", "items": {"type": "string"}},
        "requirements": {"type": "array", "items": {"type": "object", "properties": {"metric": {"type": "string"}, "min": {"type": "number"}, "max": {"type": "number"}, "equals": {}}, "required": ["metric"], "additionalProperties": false}},
        "stepsContain": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}},
        "offset": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1, "maximum": 12},
        "cursor": {"type": "string"},
        "programId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "programId": {"type": "string"},
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {"enum": ["begin", "take_gem", "discard_gem", "select_card", "select_deck", "pay_gem", "choose_noble"]},
          "action": {"enum": ["take_gems", "buy_card", "reserve_card"]},
          "color": {
            "enum": ["C", "S", "E", "R", "O", "G"],
            "description": "G is gold: only pay_gem or discard_gem may use it; take_gem must use C/S/E/R/O."
          },
          "count": {"type": "integer", "minimum": 1},
          "source": {"enum": ["market", "reserved"]},
          "cardId": {"type": "integer"},
          "level": {"enum": [1, 2, 3]},
          "nobleId": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "oneOf": [
    {"properties": {"mode": {"const": "enumerate_routes"}}, "required": ["mode", "request"], "not": {"anyOf": [{"required": ["steps"]}, {"required": ["programId"]}]}},
    {"properties": {"mode": {"const": "commit"}}, "required": ["mode", "programId", "steps"], "not": {"required": ["request"]}}
  ],
  "additionalProperties": false
}
